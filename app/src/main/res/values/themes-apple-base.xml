<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="KeyboardTheme.Apple_Base" parent="Keyboard">
        <item name="keyboardStyle">@style/Keyboard.Apple_Base</item>
        <item name="keyboardViewStyle">@style/KeyboardView.Apple_Base</item>
        <item name="mainKeyboardViewStyle">@style/MainKeyboardView.Apple_Base</item>
        <item name="emojiPalettesViewStyle">@style/EmojiPalettesView.Apple_Base</item>
        <item name="clipboardHistoryViewStyle">@style/ClipboardHistoryView.Apple_Base</item>
        <item name="popupKeysKeyboardStyle">@style/PopupKeysKeyboard.Apple_Base</item>
        <item name="popupKeysKeyboardViewStyle">@style/PopupKeysKeyboardView.Apple_Base</item>
        <item name="popupKeysKeyboardViewForActionStyle">@style/PopupKeysKeyboardView.Apple_Base.Action</item>
        <item name="suggestionStripViewStyle">@style/SuggestionStripView.Apple_Base</item>
        <item name="suggestionWordStyle">@style/SuggestionWord.Apple_Base</item>
    </style>

    <style
        name="Keyboard.Apple_Base"
        parent="Keyboard"
    >
        <item name="themeId">AppleBase</item>
    </style>

    <style
        name="KeyboardView.Apple_Base"
        parent="KeyboardView.LXX"
        >
        <item name="android:background">@color/keyboard_background_lxx_base</item>
        <item name="keyBackground">@drawable/btn_keyboard_key_apple_base</item>
        <item name="functionalKeyBackground">@drawable/btn_keyboard_key_functional_apple_base</item>
        <item name="spacebarBackground">@drawable/btn_keyboard_key_apple_base</item>
        <item name="keyTextInactivatedColor">@color/key_text_inactive_color_lxx_light</item>
        <item name="keyShiftedLetterHintInactivatedColor">@color/key_text_inactive_color_lxx_light</item>
        <item name="keyShiftedLetterHintActivatedColor">@color/key_text_color_lxx_light</item>
        <item name="keyHintLetterPadding">3dp</item>
        <item name="keyHintLabelVerticalAdjustment">15%p</item>
    </style>

    <style
        name="MainKeyboardView.Apple_Base"
        parent="KeyboardView.Apple_Base"
        >
        <item name="popupKeysKeyboardForActionLayout">@layout/popup_keys_keyboard_for_action_lxx</item>
        <item name="keyPreviewBackground">@drawable/keyboard_key_feedback_lxx_light</item>
        <item name="keyPreviewOffset">@dimen/config_key_preview_offset_lxx</item>
        <item name="languageOnSpacebarTextShadowRadius">-1.0</item>
    </style>

    <style
        name="EmojiPalettesView.Apple_Base"
        parent="MainKeyboardView.Apple_Base"
        >
        <item name="categoryPageIndicatorBackground">@color/emoji_tab_page_indicator_background_lxx_base</item>
        <item name="iconEmojiRecentsTab">@drawable/ic_emoji_recents_rounded</item>
        <item name="iconEmojiSmileysTab">@drawable/ic_emoji_smileys_emotion_rounded</item>
        <item name="iconEmojiPeopleTab">@drawable/ic_emoji_people_body_rounded</item>
        <item name="iconEmojiNatureTab">@drawable/ic_emoji_animals_nature_lxx</item>
        <item name="iconEmojiFoodTab">@drawable/ic_emoji_food_drink_rounded</item>
        <item name="iconEmojiTravelPlacesTab">@drawable/ic_emoji_travel_places_rounded</item>
        <item name="iconEmojiActivitiesTab">@drawable/ic_emoji_activities_rounded</item>
        <item name="iconEmojiObjectsTab">@drawable/ic_emoji_objects_rounded</item>
        <item name="iconEmojiSymbolsTab">@drawable/ic_emoji_symbols_rounded</item>
        <item name="iconEmojiFlagsTab">@drawable/ic_emoji_flags_rounded</item>
        <item name="iconEmojiEmoticonsTab">@drawable/ic_emoji_emoticons_rounded</item>
    </style>

    <style
        name="ClipboardHistoryView.Apple_Base"
        parent="MainKeyboardView.Apple_Base"
        >
        <item name="iconPinnedClip">@drawable/ic_clipboard_pin_rounded</item>
    </style>

    <style
        name="PopupKeysKeyboard.Apple_Base"
        parent="Keyboard.Apple_Base"
        >
        <item name="keyboardTopPadding">0%p</item>
        <item name="keyboardBottomPadding">0%p</item>
        <item name="keyboardLeftPadding">0%p</item>
        <item name="keyboardRightPadding">0%p</item>
        <item name="horizontalGap">0%p</item>
        <item name="touchPositionCorrectionData">@null</item>
    </style>

    <style
        name="PopupKeysKeyboardView.Apple_Base"
        parent="KeyboardView.Apple_Base"
        >
        <item name="android:background">@drawable/keyboard_popup_panel_background_rounded_base</item>
        <item name="keyBackground">@drawable/btn_keyboard_key_popup_rounded_base</item>
        <item name="divider">@drawable/popup_keys_divider</item>
        <item name="keyTypeface">normal</item>
        <item name="verticalCorrection">@dimen/config_popup_keys_keyboard_vertical_correction_holo</item>
    </style>

    <style
        name="PopupKeysKeyboardView.Apple_Base.Action"
        parent="PopupKeysKeyboardView.Apple_Base"
        >
        <item name="android:background">@android:color/transparent</item>
        <item name="keyBackground">@drawable/btn_keyboard_key_popup_action_lxx_base</item>
        <item name="divider">@null</item>
        <item name="keyLabelFlags">keepBackgroundAspectRatio</item>
    </style>

    <style
        name="SuggestionStripView.Apple_Base"
        parent="KeyboardView.Apple_Base"
        >
        <item name="suggestionsCountInStrip">@integer/config_suggestions_count_in_strip</item>
        <item name="centerSuggestionPercentile">@fraction/config_center_suggestion_percentile</item>
        <item name="maxMoreSuggestionsRow">@integer/config_max_more_suggestions_row</item>
        <item name="minMoreSuggestionsWidth">@fraction/config_min_more_suggestions_width</item>
        <item name="android:background">@drawable/keyboard_background_lxx_base</item>
        <item name="android:src">@drawable/suggestions_strip_divider</item>
        <item name="suggestionStripOptions">autoCorrectBold|validTypedWordBold</item>
        <item name="alphaObsoleted">70%</item>
    </style>

    <style
        name="SuggestionWord.Apple_Base"
        parent="SuggestionWord"
        >
        <item name="android:background">@drawable/btn_suggestion_rounded_base</item>
        <item name="android:textColor">@color/highlight_color_lxx_light</item>
    </style>
</resources>
